{
  "name": "labguide-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @labguide/server",
    "dev:web": "npm run dev -w @labguide/web",
    "test": "npm test -w @labguide/shared && npm test -w @labguide/server && npm test -w @labguide/web",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w @labguide/web",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "vercel-build": "npm run build && node scripts/build-vercel.mjs && npm run check:bundle-secrets"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
